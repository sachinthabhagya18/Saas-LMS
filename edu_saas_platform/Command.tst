
************************Django************************

Setup back end = py -m venv env
Activate env enviroment = .\env\Scripts\activate
Instrall the Django = pip install django
Create Project = django-admin startproject backend
Create App in Backend =  py manage.py startapp website
Run Server Backend = py manage.py runserver 
Install MySQl = pip install mysqlclient 
Migration Mysql = python manage.py makemigrations
Migrate Mysql = python manage.py migrate
Env Enviroment eka deactivete  = deactivate

pip install -r requirements.txt

Activate Enviroment = .\venv\Scripts\Activate.ps1

pip install django-cors-headers

Create Superuser = py manage.py createsuperuser
